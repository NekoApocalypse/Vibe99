{
  "name": "vibe99",
  "productName": "Vibe99",
  "version": "0.10.2",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Vibe99 terminal application",
  "scripts": {
    "postinstall": "node scripts/patch-xterm-link-cache.cjs && node scripts/prepare-pdf-assets.cjs",
    "previte:build": "node scripts/patch-xterm-link-cache.cjs && node scripts/prepare-pdf-assets.cjs",
    "test:link-cache": "node scripts/test-terminal-link-cache.cjs",
    "test": "node --test tests/terminal-stream.test.mjs tests/terminal-recovery.test.mjs tests/preview-input.test.mjs tests/terminal-file-links.test.mjs",
    "test:ui": "node scripts/test-terminal-ui.cjs",
    "test:preview": "node scripts/test-document-ui.cjs",
    "test:recovery": "node scripts/test-terminal-recovery.cjs",
    "test:review": "node scripts/test-review-ui.cjs",
    "test:diagrams": "node scripts/test-diagram-viewer.cjs",
    "release:notes": "node ./scripts/extract-release-notes.mjs",
    "release:local": "tauri build --no-bundle && powershell -NoProfile -File scripts/stage-local-release.ps1",
    "bump-version": "node ./scripts/bump-version.mjs",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:review": "tauri build --config scripts/tauri-review.conf.json",
    "test:file-links": "node scripts/test-terminal-file-links.cjs",
    "test:media": "node scripts/test-media-preview.cjs"
  },
  "overrides": {
    "mermaid": {
      "katex": "$katex"
    }
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "playwright": "^1.64.1",
    "vite": "^6.4.2"
  },
  "dependencies": {
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "^3.4.17",
    "fuse.js": "^7.3.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.2",
    "markdown-it": "^15.0.3",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "6.5.438"
  }
}
